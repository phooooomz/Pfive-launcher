    <string name="cap_metrics_detail">Read from Android. The widgets and System Monitor show the device\'s own values.</string>
    <string name="cap_cpu">System-wide CPU load</string>
    <string name="cap_cpu_detail">Android 8 and later hide it from apps. System Monitor shows only the CPU time LX itself uses.</string>
