    <string name="cap_lx_windows">LX windows</string>
    <string name="cap_lx_windows_detail">Settings, Files, System Monitor and Notes are drawn by LX, so moving, resizing, minimising and snapping always work.</string>
    <string name="cap_app_windows">Android apps in windows</string>
    <string name="cap_app_windows_yes">Android reports freeform windows. LX asks for a window at each launch, and each app decides whether it can be resized.</string>
    <string name="cap_app_windows_maybe">Android does not report freeform windows. Many phones still open them after \"Enable freeform windows\" in Developer options and a restart. Android offers apps no way to read that switch, so the only check is to try.</string>
    <string name="cap_split">Split screen</string>
    <string name="cap_split_detail">Android starts it from the Recents screen. A Home app cannot start split screen for other apps.</string>
    <string name="cap_split_low_ram">Android turns multi-window off on low-memory devices.</string>
    <string name="cap_pip">Picture in picture</string>
    <string name="cap_pip_detail">Works when the app itself offers it, usually for video.</string>
    <string name="cap_pip_none">This device does not offer picture in picture.</string>
    <string name="cap_embedding">Other apps inside LX windows</string>
    <string name="cap_embedding_detail">With LX Bridge connected, LX can run an app on a display of its own and show it inside an LX window, with LX\'s title bar. Turn it on in LX Settings > Windows. Without it, apps keep Android\'s window.</string>
    <string name="cap_home">Home app</string>
    <string name="cap_home_yes">LX is the default Home app.</string>
    <string name="cap_home_no">Another app is the default Home. Use Home app status above to choose LX.</string>
    <string name="cap_shortcuts">App shortcuts</string>
    <string name="cap_shortcuts_yes">Long-press menus show each app\'s shortcuts.</string>
    <string name="cap_shortcuts_no">Android shows app shortcuts only to the default Home app.</string>
    <string name="cap_widgets">Widgets from other apps</string>
    <string name="cap_widgets_yes">Android asks once per widget before LX may show it.</string>
    <string name="cap_widgets_no">This device does not offer app widgets.</string>
    <string name="cap_folders">Folders in File Explorer</string>
    <string name="cap_folders_all">File Explorer can open all of shared storage. Turn this off in Android\'s special app access settings.</string>
    <string name="cap_folders_all_legacy">File Explorer can open all of shared storage. Turn this off under Permissions, Storage, in this app\'s Android settings.</string>
    <string name="cap_folders_none">No folder is shared yet. Choose one in File Explorer; LX sees nothing else.</string>
    <string name="cap_removable">SD card and USB storage</string>
    <string name="cap_removable_none">No SD card or USB drive is mounted now.</string>
    <string name="cap_removable_unknown">Android did not report the storage volumes.</string>
