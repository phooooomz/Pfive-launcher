<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets the launcher hand off to Android's own uninstall dialog (API 28+). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Read-only connection state for the network widget and System Monitor. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- File Explorer and Cleanup. Android 11+: "All files access", asked for only when the user taps
         it. Android 8 to 10: the old storage permission, same rule. Without either, File Explorer keeps
         working on folders picked through the system picker. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- LX Bridge. It talks to this phone's own adb daemon over the loopback address, which Android
         counts as internet; LX opens no other socket. Wireless debugging announces its port on the
         network, and LX reads it there. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Granted by the first adb session after pairing, never at install: lets LX switch wireless
         debugging on and off so the user does not have to after every restart. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- The pairing code is typed into a notification, because leaving Android's page closes the code. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Cleanup: asks Android to close other apps' background processes to free memory. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Narrow package visibility instead of QUERY_ALL_PACKAGES: launchable
         apps, the current Home app (for the role check) and widget providers. -->
    <queries>
        <!-- BridgeSetupService reads the words on their pages from these two. -->
        <package android:name="com.android.settings" />
        <package android:name="com.android.systemui" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <!-- extractNativeLibs: Tedit's Linux runtime execs libphdp.so and libvhdp-loader.so, so they must exist as files in
         the native library folder. With it the build stores every library compressed in the APK, whatever
         useLegacyPackaging says, and the system linker cannot run a compressed one in place: lxdb starts from the
         unpacked copy in that folder (ShellHelper.library). -->
    <application
        android:name=".LxApp"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lx"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        android:localeConfig="@xml/locales_config"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="33">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:taskAffinity=""
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing|stateHidden"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection|fontWeightAdjustment|colorMode|mcc|mnc|touchscreen|grammaticalGender">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also listed as a normal app so it can be tried before choosing it as Home. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands single files to "Open with" and "Share" through opaque, read-only grants. -->
        <provider
            android:name=".files.ShareProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- LX's helper process hands its binder over here. Only the system and shell hold
             INTERACT_ACROSS_USERS_FULL; the provider also checks the caller and a token, and holds no data. -->
        <provider
            android:name=".embed.EmbedBinderProvider"
            android:authorities="${applicationId}.embed"
            android:exported="true"
            android:grantUriPermissions="false"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Off unless the user switches it on in Android's accessibility settings, and it switches itself off
             after LX Bridge's first pairing. BIND_ACCESSIBILITY_SERVICE keeps it to the system. -->
        <service
            android:name=".bridge.BridgeSetupService"
            android:enabled="@bool/bridge_supported"
            android:exported="true"
            android:label="@string/bridge_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/bridge_setup_service" />
        </service>

        <!-- Takes the pairing code from LX's own notification. -->
        <receiver
            android:name=".bridge.BridgeReceiver"
            android:exported="false" />
    </application>
</manifest>
